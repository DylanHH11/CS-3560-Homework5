@startuml
skinparam classAttributeIconSize 0

class Instructor {
  - firstName: String
  - lastName: String
  - officeNumber: String
  + Instructor(firstName: String, lastName: String, officeNumber: String)
  + getFirstName(): String
  + setFirstName(firstName: String): void
  + getLastName(): String
  + setLastName(lastName: String): void
  + getOfficeNumber(): String
  + setOfficeNumber(officeNumber: String): void
}

class Textbook {
  - title: String
  - author: String
  - publisher: String
  + Textbook(title: String, author: String, publisher: String)
  + getTitle(): String
  + setTitle(title: String): void
  + getAuthor(): String
  + setAuthor(author: String): void
  + getPublisher(): String
  + setPublisher(publisher: String): void
}

class Course {
  - courseName: String
  - instructorOne: Instructor
  - instructorTwo: Instructor
  - textbookOne: Textbook
  - textbookTwo: Textbook
  + Course(courseName: String, instructorOne: Instructor, instructorTwo: Instructor, textbookOne: Textbook, textbookTwo: Textbook)
  + getCourseName(): String
  + setCourseName(courseName: String): void
  + getInstructorOne(): Instructor
  + setInstructorOne(instructorOne: Instructor): void
  + getInstructorTwo(): Instructor
  + setInstructorTwo(instructorTwo: Instructor): void
  + getTextbookOne(): Textbook
  + setTextbookOne(textbookOne: Textbook): void
  + getTextbookTwo(): Textbook
  + setTextbookTwo(textbookTwo: Textbook): void
  + print(): void
}

Course o-- "2" Instructor
Course o-- "2" Textbook

@enduml